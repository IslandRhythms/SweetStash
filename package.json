{
  "name": "sweetstash",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "scripts": {
    "seed": "cd scripts/seed && npm install && npm run seed",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "xcode": "npx expo prebuild --platform ios",
    "build:test:android": "eas build -p android --profile preview",
    "build:test:ios": "eas build -p ios --profile preview",
    "build:test": "eas build -p all --profile preview",
    "build:production": "eas build --profile production",
    "submit:ios": "eas submit --platform ios --latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "^57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
